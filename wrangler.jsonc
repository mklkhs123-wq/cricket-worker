{
  "name": "cricket-live",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "CricketHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CricketHub"] }],
  "vars": {
    // free  = 100 hits/day plan (har ~20 min)
    // s     = $5.99 plan (score ~45 sec, scorecard + ball-by-ball ~90 sec)
    // m     = $12.99 plan (score ~10 sec, scorecard + ball-by-ball ~20 sec)
    "PLAN": "free"
  }
}
